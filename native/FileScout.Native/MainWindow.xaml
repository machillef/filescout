<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileScoutNative.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FileScoutNative"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FileScout Native">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F1E8" Offset="0" />
                <GradientStop Color="#FFE8EDF3" Offset="0.55" />
                <GradientStop Color="#FFDDE5EE" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="FileScout Native" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows 11 native rewrite: shell-backed directory browsing with modern explorer framing."
                           Opacity="0.72"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="10,4"
                    CornerRadius="999"
                    VerticalAlignment="Top"
                    Background="#E1513A">
                <TextBlock Text="Alpha"
                           Foreground="White"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Padding="20,0,20,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="Back" IsEnabled="False" MinWidth="72" />
            <Button Grid.Column="1" Content="Forward" IsEnabled="False" MinWidth="72" />
            <TextBox Grid.Column="2"
                     x:Name="AddressTextBox"
                     Header="Location"
                     PlaceholderText="Enter a filesystem path"
                     KeyDown="AddressTextBox_KeyDown" />
            <Button Grid.Column="3" Content="Refresh" Click="RefreshButton_Click" MinWidth="96" />
        </Grid>

        <Grid Grid.Row="2" Padding="20,0,20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18"
                    CornerRadius="12"
                    Background="#F7FAFDCC">
                <StackPanel Spacing="12">
                    <TextBlock Text="Places" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Desktop" />
                    <TextBlock Text="Documents" />
                    <TextBlock Text="Downloads" />
                    <TextBlock Text="This PC" />
                    <TextBlock Text="Recycle Bin" />
                    <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBlock Text="Selection" FontSize="18" FontWeight="SemiBold" />
                    <Border Width="48"
                            Height="48"
                            CornerRadius="14"
                            Background="#FFFFFFFF">
                        <Image x:Name="SelectionIconImage"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="SelectionTitleTextBlock"
                               Text="No item selected"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectionMetaTextBlock"
                               Text="Pick a folder or file to inspect its shell-backed details."
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectionPathTextBlock"
                               Text="Selection path will appear here."
                               Opacity="0.58"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="0"
                    CornerRadius="12"
                    Background="#FDFEFEF0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shell-backed items" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Explorer actions + live shell verbs" Opacity="0.72" />
                    </Grid>

                    <ListView Grid.Row="1"
                              x:Name="FileRowsListView"
                              Margin="12,0,12,12"
                              AllowDrop="True"
                              CanDrag="True"
                              DragItemsStarting="FileRowsListView_DragItemsStarting"
                              DragOver="FileRowsListView_DragOver"
                              Drop="FileRowsListView_Drop"
                              DoubleTapped="FileRowsListView_DoubleTapped"
                              RightTapped="FileRowsListView_RightTapped"
                              SelectionChanged="FileRowsListView_SelectionChanged"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="20,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Bootstrapping shell-backed directory view..."
                       Opacity="0.72" />
        </Border>
    </Grid>
</Window>
