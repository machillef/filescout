<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileScoutNative.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FileScoutNative"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FileScout Native">

    <Grid>
        <Grid.Resources>
            <Style x:Key="CardRowItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,28,6" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style x:Key="ListRowItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="GroupRowItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,28,4" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <!-- New look (docs/overhaul/look.md): compact Fluent chrome, subtle 32 px controls. -->
            <Style x:Key="ChromeToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="ChromePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeToolbarButtonStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            </Style>
            <Style x:Key="ChromeAddressTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,5,10,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
            </Style>
            <Style x:Key="ChromeInlineAddressTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ChromeDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,0,8,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <!-- P2: DataTemplates for file rows. x:DataType enables x:Bind code-gen against FileRowViewModel.
                 ItemTemplate is assigned in CreateTabListView (P3). -->
            <DataTemplate x:Key="CardRowTemplate"
                          x:DataType="local:FileRowViewModel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="{x:Bind GroupHeaderHeight, Mode=OneWay}"
                          Opacity="{x:Bind GroupHeaderOpacity, Mode=OneWay}">
                        <StackPanel Spacing="4"
                                    VerticalAlignment="Bottom">
                            <Border HorizontalAlignment="Left"
                                    Padding="9,3,9,3"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource LayerFillColorAltBrush}">
                                <TextBlock Text="{x:Bind GroupHeaderText, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="120"
                                           Opacity="0.84"
                                           TextWrapping="NoWrap" />
                            </Border>
                            <Rectangle Height="1"
                                       Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                       Opacity="0.8" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="{x:Bind SelectionOutlineOpacity, Mode=OneWay}" />
                    <Border Grid.Row="1"
                            Padding="10,6,10,6"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Border CornerRadius="10"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    Opacity="{x:Bind SelectionFillOpacity, Mode=OneWay}" />
                            <Grid ColumnSpacing="10"
                                  RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="2"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="7"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Opacity="0.82"
                                        VerticalAlignment="Center">
                                    <Image Width="16"
                                           Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Source="{x:Bind IconSource, Mode=OneWay}"
                                            Opacity="{x:Bind CutOpacity, Mode=OneWay}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind DateText}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Left"
                                        Padding="6,2,6,2"
                                        CornerRadius="999"
                                        BorderThickness="0"
                                        Background="{ThemeResource LayerFillColorAltBrush}">
                                    <TextBlock Text="{x:Bind DetailText}"
                                               FontSize="12"
                                               Opacity="0.78"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ListRowTemplate"
                          x:DataType="local:FileRowViewModel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="{x:Bind GroupHeaderHeight, Mode=OneWay}"
                          Opacity="{x:Bind GroupHeaderOpacity, Mode=OneWay}">
                        <StackPanel Spacing="3"
                                    VerticalAlignment="Bottom">
                            <Border HorizontalAlignment="Left"
                                    Padding="7,2,7,2"
                                    CornerRadius="4"
                                    BorderThickness="0"
                                    Background="{ThemeResource LayerFillColorAltBrush}">
                                <TextBlock Text="{x:Bind GroupHeaderText, Mode=OneWay}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Opacity="0.8"
                                           TextWrapping="NoWrap" />
                            </Border>
                            <Rectangle Height="1"
                                       Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                       Opacity="0.45" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1"
                            Padding="8,2,10,2"
                            CornerRadius="4"
                            BorderThickness="0"
                            Background="Transparent">
                        <Grid>
                            <Border CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    Opacity="{x:Bind SelectionFillOpacity, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="4.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.0*" />
                                    <ColumnDefinition Width="2.6*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="16"
                                       Height="16"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       Source="{x:Bind IconSource, Mode=OneWay}"
                                       Opacity="{x:Bind CutOpacity, Mode=OneWay}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Name}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind TypeLabel}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind SizeText}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalTextAlignment="Right"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind DateText}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Rectangle Height="1"
                                       Margin="28,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       Opacity="0.32" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GroupRowTemplate"
                          x:DataType="local:FileRowViewModel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Height="{x:Bind GroupHeaderHeight, Mode=OneWay}"
                            Margin="12,0,0,4"
                            Padding="10,6,10,6"
                            CornerRadius="9"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Opacity="{x:Bind GroupHeaderOpacity, Mode=OneWay}">
                        <Grid ColumnSpacing="10"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="6"
                                    Height="20"
                                    CornerRadius="3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind GroupHeaderText, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Opacity="0.9"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="GROUP"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="140"
                                       Opacity="0.56"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="24,0,0,0"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="{x:Bind SelectionOutlineOpacity, Mode=OneWay}" />
                    <Border Grid.Row="1"
                            Margin="25,1,0,1"
                            Padding="12,7,12,7"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <Border CornerRadius="10"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    Opacity="{x:Bind SelectionFillOpacity, Mode=OneWay}" />
                            <Grid ColumnSpacing="12"
                                  RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="2"
                                        Width="3"
                                        Margin="0,1,0,1"
                                        CornerRadius="2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Opacity="0.78"
                                        VerticalAlignment="Stretch" />
                                <Border Grid.Column="1"
                                        Grid.RowSpan="2"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <Image Width="16"
                                           Height="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           Source="{x:Bind IconSource, Mode=OneWay}"
                                           Opacity="{x:Bind CutOpacity, Mode=OneWay}" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind DateText}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Opacity="0.76"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Grid.ColumnSpan="2"
                                           Text="{x:Bind DetailText}"
                                           FontSize="12"
                                           Opacity="0.78"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.Background>
            <SolidColorBrush Color="Transparent" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="TitleBarDragHost"
              Background="Transparent"
              Loaded="TitleBarDragHost_Loaded"
              SizeChanged="TitleBarDragHost_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" Padding="0,0,0,8">
                <Grid x:Name="ChromeGrid"
                      Padding="12,6,12,6"
                      RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="FileScout"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.76"
                                       VerticalAlignment="Center" />
                            <Border Padding="6,2"
                                    CornerRadius="999"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Background="{ThemeResource LayerFillColorAltBrush}">
                                <TextBlock Text="Beta"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="10"
                                           Opacity="0.8" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="196" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Button x:Name="BackButton"
                                    Style="{StaticResource ChromeToolbarButtonStyle}"
                                    IsEnabled="False"
                                    Click="BackButton_Click"
                                    AutomationProperties.Name="Back"
                                    ToolTipService.ToolTip="Back">
                                <FontIcon Glyph="&#xE76B;"
                                          FontSize="14"
                                          FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="ForwardButton"
                                    Style="{StaticResource ChromeToolbarButtonStyle}"
                                    IsEnabled="False"
                                    Click="ForwardButton_Click"
                                    AutomationProperties.Name="Forward"
                                    ToolTipService.ToolTip="Forward">
                                <FontIcon Glyph="&#xE76C;"
                                          FontSize="14"
                                          FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="RefreshButton"
                                    Style="{StaticResource ChromePrimaryButtonStyle}"
                                    Click="RefreshButton_Click"
                                    AutomationProperties.Name="Refresh"
                                    ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;"
                                          FontSize="14"
                                          FontFamily="Segoe Fluent Icons" />
                            </Button>
                        </StackPanel>

                        <!-- Breadcrumb + address overlay (col 1) -->
                        <Grid Grid.Column="1">
                            <!-- Breadcrumb bar — default view; tap to reveal address TextBox -->
                            <Border x:Name="BreadcrumbBarBorder"
                                    MinHeight="32"
                                    Padding="8,0,8,0"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    Tapped="BreadcrumbBarBorder_Tapped">
                                <Grid>
                                    <ScrollViewer x:Name="BreadcrumbScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center">
                                        <StackPanel x:Name="BreadcrumbPanel"
                                                    Orientation="Horizontal"
                                                    Spacing="0"
                                                    VerticalAlignment="Center" />
                                    </ScrollViewer>
                                    <!-- Address TextBox — hidden; shown on tap or F4 -->
                                    <TextBox x:Name="AddressTextBox"
                                             Style="{StaticResource ChromeInlineAddressTextBoxStyle}"
                                             PlaceholderText="Enter a filesystem path"
                                             Visibility="Collapsed"
                                             PreviewKeyDown="AddressTextBox_KeyDown"
                                             LostFocus="AddressTextBox_LostFocus" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Dedicated search box (col 2) -->
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="2"
                                 Style="{StaticResource ChromeAddressTextBoxStyle}"
                                 PlaceholderText="Search&#x2026;"
                                 KeyDown="SearchTextBox_KeyDown"
                                 TextChanged="SearchTextBox_TextChanged" />

                        <Button x:Name="DualPaneButton"
                                Grid.Column="3"
                                Style="{StaticResource ChromeToolbarButtonStyle}"
                                MinWidth="96"
                                Padding="12,0,12,0"
                                Click="DualPaneButton_Click"
                                AutomationProperties.Name="Toggle dual pane"
                                ToolTipService.ToolTip="Show the secondary pane">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A0;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="13" />
                                <TextBlock Text="Dual pane"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <DropDownButton x:Name="ThemeDropDownButton"
                                        Grid.Column="4"
                                        Style="{StaticResource ChromeDropDownButtonStyle}"
                                        AutomationProperties.Name="Theme"
                                        ToolTipService.ToolTip="Change theme">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="●"
                                          FontFamily="Segoe UI Symbol"
                                          FontSize="12" />
                                <TextBlock Text="Theme"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DropDownButton>
                    </Grid>
                </Grid>
                <Border Height="1"
                        Margin="16,0,16,0"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" Padding="6,0,8,4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder"
                    Padding="2,4,6,4"
                    BorderThickness="0"
                    Background="Transparent">
                <ScrollViewer VerticalScrollBarVisibility="Visible"
                               VerticalScrollMode="Auto">
                    <StackPanel Spacing="10">
                        <!-- Quick Access: favorites populated by BuildSidebarFavorites(). -->
                        <Expander x:Name="QuickAccessExpander"
                                  Header="Quick Access"
                                  IsExpanded="True"
                                  Margin="0,0,0,2"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="SidebarPlacesPanel" Spacing="2" Margin="0,4,0,0" />
                        </Expander>
                        <!-- This PC: drive list populated in S3. -->
                        <Expander x:Name="ThisPCExpander"
                                  Header="This PC"
                                  IsExpanded="True"
                                  Margin="0,0,0,2"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="ThisPCPanel" Spacing="2" Margin="0,4,0,0" />
                        </Expander>
                        <!-- Bookmarks: pinned folders populated in S4. -->
                        <Expander x:Name="BookmarksExpander"
                                  Header="Bookmarks"
                                  IsExpanded="False"
                                  Margin="0,0,0,2"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="BookmarksPanel" Spacing="2" Margin="0,4,0,0" />
                        </Expander>
                        <Border Height="1" Margin="0,4,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="Selection"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   CharacterSpacing="80"
                                   Opacity="0.74" />
                        <!-- Image preview — shown when an image file is selected (R10). -->
                        <Border x:Name="PreviewBorder"
                                MaxHeight="160"
                                CornerRadius="12"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                Visibility="Collapsed">
                            <Image x:Name="PreviewImage"
                                   MaxHeight="160"
                                   Stretch="Uniform" />
                        </Border>
                        <!-- Icon tile — shown when no image preview is available. -->
                        <Border x:Name="SelectionIconBorder"
                                Width="52"
                                Height="52"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Image x:Name="SelectionIconImage"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="SelectionTitleTextBlock"
                                   Text="No item selected"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectionMetaTextBlock"
                                   Text="Pick a folder or file to inspect its shell-backed details."
                                   Opacity="0.72"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectionCreatedTextBlock"
                                   Opacity="0.58"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="SelectionAttributesTextBlock"
                                   Opacity="0.55"
                                   FontSize="11"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="SelectionPathTextBlock"
                                   Text="Selection path will appear here."
                                   Opacity="0.58"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Left pane — active indicator applied as the accent border -->
            <Border Grid.Column="1"
                    x:Name="LeftPaneBorder"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Sort column header row — populated programmatically in BuildSortHeader(). -->
                    <Border x:Name="LeftPaneSortHeader"
                            Grid.Row="0"
                            Padding="14,4,14,2"
                            Background="Transparent" />
                    <!-- Search progress indicator — visible only during Recursive search (R17d). -->
                    <ProgressBar x:Name="LeftPaneSearchProgress"
                                 Grid.Row="1"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                    <TabView x:Name="LeftPaneTabView"
                             Grid.Row="2"
                             TabWidthMode="SizeToContent"
                             CloseButtonOverlayMode="OnPointerOver"
                             Background="Transparent"
                             AddTabButtonClick="PaneTabView_AddTabButtonClick"
                             TabCloseRequested="PaneTabView_TabCloseRequested"
                             SelectionChanged="PaneTabView_SelectionChanged" />
                </Grid>
            </Border>

            <!-- Right pane — inactive by default -->
            <Border Grid.Column="2"
                    x:Name="RightPaneBorder"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Sort column header row — populated programmatically in BuildSortHeader(). -->
                    <Border x:Name="RightPaneSortHeader"
                            Grid.Row="0"
                            Padding="14,4,14,2"
                            Background="Transparent" />
                    <!-- Search progress indicator — visible only during Recursive search (R17d). -->
                    <ProgressBar x:Name="RightPaneSearchProgress"
                                 Grid.Row="1"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                    <TabView x:Name="RightPaneTabView"
                             Grid.Row="2"
                             TabWidthMode="SizeToContent"
                             CloseButtonOverlayMode="OnPointerOver"
                             Background="Transparent"
                             AddTabButtonClick="PaneTabView_AddTabButtonClick"
                             TabCloseRequested="PaneTabView_TabCloseRequested"
                             SelectionChanged="PaneTabView_SelectionChanged" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="StatusBarBorder"
                Grid.Row="2"
                Padding="14,2,14,6"
                Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Bootstrapping shell-backed directory view..."
                           VerticalAlignment="Center"
                           Opacity="0.72" />
            </StackPanel>
        </Border>

        <!-- Command palette overlay: shown by Ctrl+P (the palette feature gate is on). -->
        <Grid x:Name="CommandPaletteOverlay"
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed">
            <Border Width="560"
                    MaxHeight="440"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,80,0,0"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel>
                    <TextBox x:Name="CommandPaletteTextBox"
                             PlaceholderText="Type a command…"
                             FontSize="15"
                             Padding="16,10"
                             BorderThickness="0,0,0,1"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             Background="Transparent"
                             TextChanged="CommandPalette_TextChanged"
                             KeyDown="CommandPalette_TextBox_KeyDown" />
                    <ListView x:Name="CommandPaletteListView"
                              MaxHeight="360"
                              Padding="0,4,0,4"
                              ItemClick="CommandPalette_ItemClick"
                              IsItemClickEnabled="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
