namespace FileScoutNative
{
    [default_interface]
    runtimeclass FileRowViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        FileRowViewModel();

        String Name { get; };

        String TypeLabel { get; };

        String SizeText { get; };

        String DateText { get; };

        String DetailText { get; };

        Boolean IsFolder { get; };

        Boolean IsSelected { get; set; };

        Double CutOpacity { get; };

        Double SelectionOutlineOpacity { get; };
        Double SelectionFillOpacity { get; };

        String GroupHeaderText { get; };
        Double GroupHeaderOpacity { get; };
        Double GroupHeaderHeight { get; };

        Microsoft.UI.Xaml.Media.ImageSource IconSource { get; set; };
    }
}
